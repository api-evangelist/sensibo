{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sensibo AC States Devices API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apiKey",
      "value": "{{apiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Devices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get specific device info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://home.sensibo.com/api/v2/pods/:device_id",
            "params": [
              {
                "name": "device_id",
                "value": "",
                "type": "path",
                "description": "The pod (device) identifier."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include in the response, or `*` for all fields."
              }
            ]
          },
          "docs": "Returns full detail for a single pod - model, room, connection status, firmware, capabilities, and the last known AC state and measurements."
        }
      ]
    }
  ],
  "bundled": true
}